# ---- Secrets: never commit these ----
# Real environment files. .env.example is the committed template and is not matched.
.env
.env.*
!.env.example
# Keys, certificates and credential stores, wherever they appear.
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
credentials.json
secrets.*
*.secret
.netrc
.pypirc
.npmrc

