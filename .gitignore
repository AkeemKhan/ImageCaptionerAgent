data/
*.db
*.db-journal
*.sqlite
*.sqlite3
uploads/
outputs/
sessions/

# ---- Logs and temporary files ----
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
desktop.ini

