# Copy this file to .env and fill in your keys. .env is ignored by git.

# Required. Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Only for Gemini cleanup and upscaling (gemini_cleanup: true in
# captioner-agent/config/settings.yaml). Create a key at https://aistudio.google.com/apikey
# and turn on billing for its project: image output is not part of the free tier.
# Images are sent to Google only when you choose Gemini in the chat.
GEMINI_API_KEY=
